# Copy to .env (git-ignored) and fill in. Never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (docker compose up -d db exposes it on localhost:5442)
DATABASE_URL=postgres://metering:metering@localhost:5442/metering
# Used only by `npm test` (a separate database, created automatically)
TEST_DATABASE_URL=postgres://metering:metering@localhost:5442/metering_test

# --- Stripe (TEST MODE ONLY: keys must start with sk_test_ / rk_test_) ---
# Dashboard -> Developers -> API keys (test mode toggle ON)
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `stripe listen --forward-to localhost:3000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Created by `npm run stripe:setup` (recurring monthly price for the Pro plan)
STRIPE_PRICE_PRO=price_replace_me
CHECKOUT_SUCCESS_URL=http://localhost:3000/health?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:3000/health?checkout=cancelled

# --- Background worker (usage alerts) ---
WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_MS=2000

# Vercel build only; use a real external HTTPS backend origin.
# BACKEND_ORIGIN=https://your-backend-host.example
